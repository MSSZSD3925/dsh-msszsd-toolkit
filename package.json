{
  "name": "dsh-msszsd-toolkit",
  "version": "0.5.0",
  "description": "DSH 小功能合集：QQ 远程驾驶、跨会话提问、界面暂停按钮、重启与重启后自动续跑、贵时段纪律按时间注入",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "deepseek-harness",
    "onebot",
    "qq"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSSZSD3925/dsh-msszsd-toolkit.git"
  },
  "homepage": "https://github.com/MSSZSD3925/dsh-msszsd-toolkit#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/local-config.mjs && node test-guard.mjs && node test-slots.mjs && node test-team.mjs && node test-toggles.mjs && node test-transport.mjs && node test-bridge.mjs && node test-adapter.mjs && node e2e-onebot.mjs && node test-adapter-route.mjs && node test-request.mjs && node test-keylink.mjs && node test-discipline.mjs && node test-workbuddy.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "waker.mjs",
    "restart.ps1",
    "install-restart.ps1",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "onebot.js": "0.2.1"
  },
  "bugs": {
    "url": "https://github.com/MSSZSD3925/dsh-msszsd-toolkit/issues"
  }
}
